<div class="max-w-xl mx-auto mt-10 bg-white p-8 rounded-lg shadow-md">
  <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Pendaftaran Karyawan Baru</h2>

  <!-- Area Peringatan Error -->
  <%= render "users/shared/error_messages", resource: resource %>

  <!-- Form Devise -->
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "registration-form" }) do |f| %>
    
    <div class="mb-4">
      <%= f.label :name, "Nama Lengkap", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, autofocus: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
    </div>

    <div class="mb-4">
      <%= f.label :email, "Alamat Email", class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autocomplete: "email", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-6">
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Konfirmasi Password", class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
      </div>
    </div>

    <!-- Area Kamera Pendaftaran Wajah -->
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">Perekaman Wajah (Biometrik)</label>
      <div class="relative bg-gray-200 rounded-lg overflow-hidden flex justify-center items-center h-56">
        <video id="webcam" autoplay playsinline class="w-full h-full object-cover"></video>
        <canvas id="canvas" class="hidden"></canvas>
      </div>
      <p class="text-xs text-gray-500 mt-2 text-center">Pastikan wajah terlihat jelas dan pencahayaan cukup. Wajah Anda akan langsung dienkripsi dan gambar asli akan dihapus.</p>
    </div>

    <!-- Input Tersembunyi untuk Gambar Base64 -->
    <%= f.hidden_field :face_image, id: "face_image_input" %>

    <!-- Tombol Submit Kustom -->
    <button type="button" id="btn-register" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded transition duration-200">
      Rekam Wajah & Daftarkan Akun
    </button>
  <% end %>

  <div class="mt-4 text-center">
    <%= render "users/shared/links" %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.getElementById('webcam');
    const canvas = document.getElementById('canvas');
    const form = document.getElementById('registration-form');
    const btnRegister = document.getElementById('btn-register');
    const hiddenImageInput = document.getElementById('face_image_input');

    // Minta Akses Webcam
    navigator.mediaDevices.getUserMedia({ video: true })
      .then(stream => {
        video.srcObject = stream;
      })
      .catch(err => {
        alert("Akses kamera ditolak. Pendaftaran tidak dapat dilanjutkan.");
        btnRegister.disabled = true;
      });

    // Modifikasi Alur Submit
    btnRegister.addEventListener('click', () => {
      // 1. Validasi form dasar browser terlebih dahulu
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      btnRegister.innerText = "Memproses AI & Mendaftarkan...";
      btnRegister.disabled = true;

      // 2. Tangkap Gambar dari Video
      const context = canvas.getContext('2d');
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      context.drawImage(video, 0, 0, canvas.width, canvas.height);
      
      // 3. Masukkan ke hidden field
      const base64Image = canvas.toDataURL('image/jpeg');
      hiddenImageInput.value = base64Image;

      // 4. Lanjutkan Submit Form ke Controller Rails
      form.submit();
    });
  });
</script>