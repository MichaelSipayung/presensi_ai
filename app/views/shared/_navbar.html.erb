<nav class="bg-white shadow-md mb-6">
  <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
    <!-- Logo Kiri -->
    <a href="<%= root_path %>" class="text-2xl font-bold text-indigo-600">Presensi AI</a>

    <!-- Menu Kanan -->
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <!-- Jika Ada yang Sedang Login -->
        <span class="text-sm text-gray-600 bg-gray-100 px-3 py-1 rounded-full">
          Sesi Aktif: <strong><%= current_user.name %></strong>
        </span>
        
        <!-- Tombol Logout (Rails 7/8 menggunakan method: :delete via button_to) -->
        <%= button_to "Logout (Tutup Sesi)", destroy_user_session_path, method: :delete, class: "bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded text-sm font-bold shadow transition duration-200" %>
      <% else %>
        <!-- Jika Posisi Kosong / Mesin Standby -->
        <%= link_to "Login Manual", new_user_session_path, class: "text-gray-600 hover:text-indigo-600 font-medium text-sm mr-2" %>
        
        <%= link_to "Daftar Karyawan Baru", new_user_registration_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded text-sm font-bold shadow transition duration-200" %>
      <% end %>
    </div>
  </div>
</nav>